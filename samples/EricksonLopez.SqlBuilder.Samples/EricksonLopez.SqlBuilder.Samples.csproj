    <ProjectReference Include="..\..\src\EricksonLopez.SqlBuilder.Dapper.Aot\EricksonLopez.SqlBuilder.Dapper.Aot.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.SqlBuilder.MariaDb\EricksonLopez.SqlBuilder.MariaDb.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.SqlBuilder.MySql\EricksonLopez.SqlBuilder.MySql.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.SqlBuilder.OpenTelemetry\EricksonLopez.SqlBuilder.OpenTelemetry.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.SqlBuilder.Oracle\EricksonLopez.SqlBuilder.Oracle.csproj" />
