<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>PostgreSqlPlayground</AssemblyName>
    <RootNamespace>EricksonLopez.SqlBuilder.Playgrounds.PostgreSql</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Dapper" VersionOverride="2.1.79" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\EricksonLopez.SqlBuilder\EricksonLopez.SqlBuilder.csproj" />
    <ProjectReference Include="..\..\..\src\EricksonLopez.SqlBuilder.PostgreSql\EricksonLopez.SqlBuilder.PostgreSql.csproj" />
    <ProjectReference Include="..\..\..\src\EricksonLopez.SqlBuilder.Dapper\EricksonLopez.SqlBuilder.Dapper.csproj" />
    <ProjectReference Include="..\..\..\src\EricksonLopez.SqlBuilder.SourceGenerators\EricksonLopez.SqlBuilder.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
