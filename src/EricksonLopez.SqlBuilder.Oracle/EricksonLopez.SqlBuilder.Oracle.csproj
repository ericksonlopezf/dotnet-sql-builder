<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.SqlBuilder\EricksonLopez.SqlBuilder.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EricksonLopez.SqlBuilder.Oracle.UnitTests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <PackageTags>$(CommonPackageTags);oracle;oracle-db;plsql;dialect;query-compiler</PackageTags>
    <!-- Non-AOT: Oracle.ManagedDataAccess.Core depends on dynamic reflection and runtime Emit, which are incompatible with Native AOT and trimming. -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>


  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="Oracle.ManagedDataAccess.Core" />
  </ItemGroup>
</Project>
