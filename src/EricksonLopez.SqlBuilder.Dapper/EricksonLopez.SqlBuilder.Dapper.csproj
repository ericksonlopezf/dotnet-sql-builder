<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.SqlBuilder\EricksonLopez.SqlBuilder.csproj" />
    <PackageReference Include="EricksonLopez.Pagination.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" VersionOverride="2.1.79" />

    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" VersionOverride="8.0.2" />
    
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>

    <PackageId>EricksonLopez.SqlBuilder.Dapper</PackageId>
    <Version>1.0.0</Version>
    <Authors>Erickson Lopez</Authors>
    <Description>Seamless integration with Dapper and OpenTelemetry for EricksonLopez.SqlBuilder.</Description>
    <RepositoryUrl>https://github.com/ericksonlopezf/dotnet-sql-builder</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>$(CommonPackageTags);dapper;micro-orm;data-access;unit-of-work;multi-mapping</PackageTags>
    <!-- QueryAsync<T> relies on Dapper's reflection-based IL-emitted mapper — not NativeAOT compatible -->
    <!-- For NativeAOT scenarios, use QueryAotAsync<T> in EricksonLopez.SqlBuilder.Aot -->
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>


  <ItemGroup>
    <InternalsVisibleTo Include="EricksonLopez.SqlBuilder.Dapper.UnitTests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>



