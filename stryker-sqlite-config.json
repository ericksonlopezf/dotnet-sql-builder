{
  "stryker-config": {
    "project": "EricksonLopez.SqlBuilder.Sqlite.csproj",
    "test-projects": [
      "EricksonLopez.SqlBuilder.Sqlite.UnitTests.csproj"
    ],
    "mutate": [
      "**/*.cs",
      "!bin/**",
      "!obj/**",
      "!**/*.g.cs",
      "!**/*.AssemblyInfo.cs"
    ],
    "thresholds": {
      "high": 100,
      "low": 98,
      "break": 95
    },
    "reporters": [
      "html",
      "json",
      "cleartext",
      "progress"
    ],
    "concurrency": 4
  }
}