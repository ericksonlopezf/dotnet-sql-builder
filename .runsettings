<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <TestCaseFilter>Category!=Integration</TestCaseFilter>
  </RunConfiguration>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>opencover,cobertura</Format>
          <Exclude>[*Analyzers*]*,[*SourceGenerators*]*,[*Testing*]*,[*Tests*]*,[*Benchmarks*]*,[*Samples*]*,[*Playground*]*</Exclude>
          <ExcludeByFile>**/Generated/**,**/*.g.cs,**/Infrastructure/DDL/**,**/docs/**,**/samples/**,**/benchmarks/**</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
