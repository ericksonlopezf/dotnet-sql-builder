{
  "stryker-config": {
    "project": "EricksonLopez.SqlBuilder.Aot.csproj",
    "concurrency": 2,
    "mutation-level": "Standard",
    "coverage-analysis": "perTest",
    "reporters": [
      "json",
      "html",
      "progress"
    ],
    "thresholds": {
      "high": 100,
      "low": 98,
      "break": 95
    },
    "ignore-methods": [
      "*ConfigureAwait"
    ],
    "mutate": [
      "**/*.cs"
    ]
  }
}
