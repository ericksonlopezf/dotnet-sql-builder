{
  "stryker-config": {
    "project": "EricksonLopez.SqlBuilder.Analyzers.csproj",
    "concurrency": 2,
    "mutation-level": "Standard",
    "coverage-analysis": "all",
    "reporters": [
      "html",
      "json",
      "cleartext",
      "progress"
    ],
    "thresholds": {
      "high": 100,
      "low": 98,
      "break": 95
    },
    "ignore-methods": [
      "*ConfigureAwait",
      "*EnableConcurrentExecution",
      "*ConfigureGeneratedCodeAnalysis",
      "*GetFixAllProvider"
    ],
    "mutate": [
      "**/*.cs"
    ]
  }
}
