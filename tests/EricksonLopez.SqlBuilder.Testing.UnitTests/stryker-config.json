{
  "stryker-config": {
    "project": "EricksonLopez.SqlBuilder.Testing.csproj",
    "concurrency": 2,
    "mutation-level": "Standard",
    "coverage-analysis": "perTest",
    "reporters": [
      "html",
      "json",
      "progress"
    ],
    "thresholds": {
      "high": 100,
      "low": 98,
      "break": 95
    },
    "ignore-methods": [
      "*ConfigureAwait",
      "Dispose"
    ],
    "mutate": [
      "**/*.cs",
      "!Infrastructure/**",
      "!Abstractions/**",
      "!Seeders/**",
      "!Domain/**",
      "!DataBuilders/**",
      "!bin/**",
      "!obj/**",
      "!**/*.g.cs",
      "!**/*.AssemblyInfo.cs"
    ]
  }
}
